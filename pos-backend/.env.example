# Copia este archivo a .env y ajusta valores para tu entorno local.
# NUNCA commitear un .env real (ver .gitignore) — en producción estas
# credenciales viven en Azure Key Vault, no en variables de entorno planas
# del App Service (documentacion/brief_infraestructura_carlos.md §3/§7).

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT (rest_framework_simplejwt) — secret propio para firmar tokens de
# acceso/refresh, separado de SECRET_KEY (así se puede rotar uno sin tocar
# el otro). Si se omite, cae al default de SimpleJWT (usa SECRET_KEY).
JWT_SIGNING_KEY=change-me-too

# PostgreSQL — instancia única compartida entre todos los tenants (ver
# arquitectura_tecnica_pos.md §5). Con docker-compose, DB_HOST=db (nombre
# del servicio); corriendo el backend fuera de Docker, DB_HOST=localhost.
DB_NAME=arkdev_pos_dev
DB_USER=arkdev
DB_PASSWORD=arkdev_dev_password
DB_HOST=localhost
DB_PORT=5432
